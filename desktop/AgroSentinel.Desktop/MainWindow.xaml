<Window x:Class="AgroSentinel.Desktop.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Style="{StaticResource AppWindow}" Title="AgroSentinel - Field monitor" Width="1280" Height="890" MinWidth="980" MinHeight="700" WindowStartupLocation="CenterScreen" Closing="WindowClosing" PreviewKeyDown="WindowKeys">
<DockPanel Background="#EFF3F5"><Menu DockPanel.Dock="Top" Background="White" Padding="18,6" FontSize="14"><MenuItem Header="_File"><MenuItem Header="_Open photo or video..." InputGestureText="Ctrl+O" Click="BrowseSource"/><MenuItem Header="_Export activity..." InputGestureText="Ctrl+S" Click="ExportActivity"/><Separator/><MenuItem Header="E_xit" Click="ExitClick"/></MenuItem><MenuItem Header="_Monitor"><MenuItem Header="_Start monitoring" InputGestureText="F5" Click="StartClick"/><MenuItem Header="S_top" InputGestureText="Shift+F5" Click="StopClick"/><Separator/><MenuItem Header="Connect _phone" Click="ConnectionClick"/><MenuItem Header="Open app _data" Click="OpenDataClick"/></MenuItem><MenuItem Header="_Help"><MenuItem Header="_Getting started" Click="HelpClick"/><MenuItem Header="_About AgroSentinel" Click="AboutClick"/></MenuItem></Menu><Grid Margin="24,18,24,14"><Grid.RowDefinitions><RowDefinition Height="76"/><RowDefinition Height="*"/><RowDefinition Height="32"/></Grid.RowDefinitions>
<Grid><StackPanel><TextBlock Text="AgroSentinel" FontSize="30" FontWeight="SemiBold"/><TextBlock Text="Field monitoring - Windows" FontSize="14" Foreground="#40555F" Margin="0,4,0,0"/></StackPanel><Border HorizontalAlignment="Right" VerticalAlignment="Center" Background="#E2ECE2" CornerRadius="16" Padding="18,9"><TextBlock x:Name="StateText" Text="Ready" Foreground="#245D43" FontSize="14" FontWeight="SemiBold"/></Border></Grid>
<Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="370"/><ColumnDefinition Width="24"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
<Border Background="White" BorderBrush="#DDE5DC" BorderThickness="1" CornerRadius="16" Padding="22"><Grid><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
<TabControl x:Name="SettingsTabs" BorderThickness="0" Background="White" Padding="0,14,0,0"><TabItem Header="Monitor"><ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel Margin="0,0,10,0">



<TextBlock Text="Camera &amp; detection" Style="{StaticResource SectionTitle}"/>
<TextBlock Text="Input type" Style="{StaticResource FieldLabel}"/><ComboBox x:Name="SourceMode" SelectedIndex="0"><ComboBoxItem Content="Continuous camera / video / stream"/><ComboBoxItem Content="Single photo (one analysis)"/></ComboBox>
<TextBlock Text="Camera number, file or stream address" Style="{StaticResource FieldLabel}" Margin="0,14,0,7"/>
<Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="86"/></Grid.ColumnDefinitions><TextBox x:Name="SourceText" Text="0" ToolTip="0 = default camera. Enter a video file or RTSP address."/><Button Grid.Column="1" Content="Browse" Click="BrowseSource" Margin="8,0,0,0" Padding="8" Style="{StaticResource SecondaryButton}"/></Grid>
<CheckBox x:Name="LoopVideo" Content="Repeat video until I press Stop" IsChecked="True" Margin="0,16,0,0"/><TextBlock Text="Cameras and live streams reconnect automatically when interrupted." Foreground="#40555F" FontSize="13" Margin="0,8,0,0"/><TextBlock Text="Active models" Style="{StaticResource FieldLabel}" Margin="0,16,0,7"/><ComboBox x:Name="ModelProfile" SelectedIndex="0"><ComboBoxItem Content="Fire + tomato leaves"/><ComboBoxItem Content="Fire only"/><ComboBoxItem Content="Tomato leaves only"/></ComboBox>
<TextBlock Text="For plant analysis, fill the frame with one tomato leaf. Healthy and uncertain results produce no disease alert." Foreground="#40555F" FontSize="13" Margin="0,10,0,0"/><Border Height="1" Background="#E5EBE3" Margin="0,18,0,10"/><CheckBox x:Name="SyncEnabled" Content="Send confirmed events to phone" IsChecked="True" Margin="0,14,0,0"/>
<Expander Header="Advanced: choose fire model" Margin="0,20,0,0" Foreground="#294D38" FontSize="13"><StackPanel Margin="0,10,0,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="86"/></Grid.ColumnDefinitions><TextBox x:Name="FireModel" ToolTip="Leave empty to use the bundled selected model"/><Button Grid.Column="1" Content="Choose" Click="BrowseModel" Margin="8,0,0,0" Padding="8" Style="{StaticResource SecondaryButton}"/></Grid></StackPanel></Expander>
<Button x:Name="RetryButton" Content="Retry pending uploads" Click="RetryClick" Style="{StaticResource SecondaryButton}" Margin="0,20,0,14"/>
</StackPanel></ScrollViewer></TabItem><TabItem Header="Connection"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="0,14,0,0"><TextBlock Text="1. Sign in on the phone. 2. Generate a code here. 3. Open phone Settings > Server &amp; paired devices and enter it." Foreground="#40555F" FontSize="13" Margin="0,0,0,16"/>
<TextBlock Text="Website address" Style="{StaticResource FieldLabel}"/><TextBox x:Name="ApiUrl" ToolTip="Already configured for your hosted AgroSentinel server"/>
<Button x:Name="PairButton" Content="Generate pairing code" Click="PairClick" Margin="0,10,0,0" Style="{StaticResource SecondaryButton}"/>
<TextBlock x:Name="PairCode" FontSize="26" FontWeight="SemiBold" Foreground="#245D43" Margin="0,10,0,2"><TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers><Trigger Property="Text" Value=""><Setter Property="Visibility" Value="Collapsed"/></Trigger></Style.Triggers></Style></TextBlock.Style></TextBlock><TextBlock x:Name="PairStatus" Text="Pair once to send detections to your account." Foreground="#40555F" FontSize="13"/>
</StackPanel></ScrollViewer></TabItem></TabControl>
<Grid Grid.Row="1" Margin="0,16,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="10"/><ColumnDefinition Width="88"/></Grid.ColumnDefinitions><Button x:Name="StartButton" Content="Start monitoring" Click="StartClick" FontSize="15"/><Button x:Name="StopButton" Grid.Column="2" Content="Stop" Click="StopClick" IsEnabled="False" Style="{StaticResource SecondaryButton}"/></Grid>
</Grid></Border>
<Grid Grid.Column="2"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="18"/><RowDefinition Height="220"/></Grid.RowDefinitions>
<StackPanel Margin="0,0,0,16"><TextBlock Text="Live monitor" FontSize="28" FontWeight="SemiBold"/><TextBlock x:Name="PreviewStatus" Text="Analysis runs on this laptop. Events sync to your phone." Foreground="#40555F" FontSize="14" Margin="0,5,0,0"/></StackPanel>
<Border Grid.Row="1" Background="#16271E" CornerRadius="16" ClipToBounds="True"><Grid><Image x:Name="Preview" Stretch="Uniform"/><StackPanel x:Name="PreviewHint" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="28"><TextBlock Text="Your camera, in focus." Foreground="#F0F5EF" FontSize="24" FontWeight="SemiBold" TextAlignment="Center"/><TextBlock Text="Choose a source and start monitoring.&#10;The live preview will appear here." Foreground="#BED0C1" FontSize="15" TextAlignment="Center" Margin="0,12,0,0"/></StackPanel></Grid></Border>
<Border Grid.Row="3" Background="White" BorderBrush="#DDE5DC" BorderThickness="1" CornerRadius="14" Padding="18"><Grid><Grid.RowDefinitions><RowDefinition Height="30"/><RowDefinition/></Grid.RowDefinitions><TextBlock Text="Activity" FontSize="16" FontWeight="SemiBold"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="Export" Click="ExportActivity" Style="{StaticResource SecondaryButton}" Padding="10,5"/><Button Content="Clear" Click="ClearActivity" Style="{StaticResource SecondaryButton}" Padding="10,5" Margin="8,0,0,0"/></StackPanel><TextBox x:Name="Activity" Grid.Row="1" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" BorderThickness="0" Background="#F7F9F5" FontFamily="Consolas" FontSize="13" Padding="10"/></Grid></Border>
</Grid></Grid>
<DockPanel Grid.Row="2" VerticalAlignment="Bottom"><TextBlock DockPanel.Dock="Right" x:Name="SessionTime" Text="Session 00:00:00" Foreground="#40555F" FontSize="13"/><TextBlock x:Name="QueueStatus" Text="Ready to monitor" Foreground="#40555F" FontSize="13"/></DockPanel>
</Grid></DockPanel></Window>
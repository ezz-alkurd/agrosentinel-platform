{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"urn:agrosentinel:analysis-request:1",
  "title":"Create analysis request",
  "type":"object",
  "additionalProperties":false,
  "required":["media_id","models","captured_at","source_mode","idempotency_key"],
  "properties":{
    "media_id":{"type":"string","minLength":1},
    "models":{"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string","enum":["plant-closeup","plant-far","fire-smoke"]}},
    "camera_id":{"type":["string","null"]},
    "captured_at":{"type":"string","format":"date-time"},
    "source_mode":{"type":"string","enum":["manual","live","recorded"]},
    "execution_mode":{"type":"string","enum":["cloud","edge"],"default":"cloud"},
    "idempotency_key":{"type":"string","minLength":16,"maxLength":128}
  }
}

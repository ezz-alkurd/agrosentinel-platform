rules_version = '2';

// AgroSentinel Firestore security rules.
// This matches what is ALREADY LIVE in project agriculture-drone-e0dc0
// (verified July 2, 2026). No publish needed — kept here for version control.
//
// - Detection events are CREATED by the backend (Admin SDK), which bypasses
//   these rules. Clients never need write access.
// - Signed-in app users may READ the events feed.
// - Any path without a matching rule is denied by Firestore by default.

service cloud.firestore {
  match /databases/{database}/documents {

    match /events/{doc} {
      allow read:   if request.auth != null;
      allow delete: if request.auth != null;   // users can delete events from the app
      allow create, update: if false;          // created only by the backend (Admin SDK)
    }

    // Devices — the detector writes its heartbeat here (Admin SDK), and the
    // app lets signed-in users add / rename / remove their own devices.
    match /devices/{doc} {
      allow read:  if request.auth != null;
      allow write: if request.auth != null;
    }
  }
}
